# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Used for Supabase email-confirmation / OAuth redirect links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 32-byte key, base64-encoded, used to encrypt provider API keys at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
KEY_ENCRYPTION_SECRET=

# Server-only. Supabase project -> Settings -> API Keys -> "Secret key"
# (formerly "service_role"). Bypasses row-level security -- only ever used
# from src/lib/supabase/admin.ts, and only after an admin check. Never
# import it outside that file, never expose it to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated list of emails allowed to reach /admin. There's no
# separate admin login -- these accounts sign in through the normal
# /login page like everyone else.
ADMIN_EMAILS=
